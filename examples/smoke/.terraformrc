# Local dev_overrides. Point at the directory containing the
# `terraform-provider-hcloudplus` binary you built with `make build`
# (or `go build -o ...`). Commit-safe only because the path is a
# user-specific absolute path — edit to match your checkout.
#
# Use this for one-shot iteration without a registry install:
#
#   export TF_CLI_CONFIG_FILE="$PWD/.terraformrc"
#   terraform plan      # skip `init` — dev_overrides bypasses it

provider_installation {
  dev_overrides {
    "hatemosphere/hcloudplus" = "/CHANGE/ME/TO/ABSOLUTE/PATH/OF/REPO/ROOT"
  }
  direct {}
}
